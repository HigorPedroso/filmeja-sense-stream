<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No <inset>: the background should fill the full tile, and the
         foreground already has its safe-zone margin baked in (see
         resources/icon-foreground.png), so an extra XML inset would shrink
         the icon twice and make it look lost on the home screen. -->
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>